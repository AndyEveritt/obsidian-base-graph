filters:
  and:
    - type == "mission"
formulas:
  target_count: targets.length
properties:
  note.mission_type:
    displayName: Type
  note.launched:
    displayName: Launched
  formula.target_count:
    displayName: Targets visited
views:
  - type: base-graph
    name: Graph
    groupBy:
      property: agency
      direction: ASC
    order:
      - agency
      - launched
      - targets
      - formula.target_count
    clusterBy: note.agency
    depth: 1
    direction: outgoing
    sizeProperty: formula.target_count
    showArrows: true
    height: 600
    clusterByGroup: true
  - type: base-graph
    name: Rings
    filters:
      and:
        - mission_type == "impactor"
    order:
      - file.name
    depth: 2
    layout: rings
  - type: base-graph
    name: Crew
    filters:
      and:
        - mission_type == "crewed"
    groupBy:
      property: launched
      direction: ASC
    order:
      - launched
      - crew
      - missions
      - role
    depth: 1
    direction: outgoing
    linkProperties:
      - crew
      - missions
    showArrows: true
  - type: base-graph
    name: Since 2010
    filters:
      and:
        - launched >= 2010
    groupBy:
      property: mission_type
      direction: ASC
    showUnresolved: true
  - type: table
    name: Table
    order:
      - file.name
      - agency
      - launched
      - mission_type
      - targets
      - formula.target_count
