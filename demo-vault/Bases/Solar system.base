filters:
  and:
    - type == "body"
views:
  - type: base-graph
    name: Graph
    groupBy:
      property: category
      direction: ASC
    depth: 0
  - type: base-graph
    name: Moons
    groupBy:
      property: category
      direction: ASC
    order:
      - category
      - orbits
      - moons
    linkProperties:
      - orbits
      - moons
    showArrows: true
  - type: base-graph
    name: Visited by
    groupBy:
      property: category
      direction: ASC
    depth: 1
    direction: incoming
  - type: table
    name: Table
    order:
      - file.name
      - category
      - orbits
