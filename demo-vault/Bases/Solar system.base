filters:
  and:
    - type == "body"
views:
  - type: base-graph
    name: Graph
    groupBy:
      property: category
      direction: ASC
    depth: 0
  - type: base-graph
    name: Moons
    groupBy:
      property: category
      direction: ASC
    order:
      - category
      - orbits
      - moons
    linkProperties:
      - orbits
      - moons
    showArrows: true
  - type: base-graph
    name: Orbits
    groupBy:
      property: category
      direction: ASC
    order:
      - category
      - orbits
    linkProperties:
      - orbits
    layout: layered
    showArrows: true
    centerForce: 0.04
    linkDistance: 100
    repelForce: 10
    otherLinks: false
    clusterByGroup: true
    depth: 1
  - type: base-graph
    name: Visited by
    groupBy:
      property: category
      direction: ASC
    depth: 1
    direction: incoming
  - type: table
    name: Table
    order:
      - file.name
      - category
      - orbits
