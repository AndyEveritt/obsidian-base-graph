filters:
  and:
    - file.hasProperty("type")
views:
  - type: base-graph
    name: Graph
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - orbits
      - role
      - targets
      - mission_type
      - launched
      - country
      - category
      - agency
    showArrows: false
    depth: 0
    clusterBy: note.type
    clusterByGroup: true
    clusterOutlines: true
  - type: table
    name: Table
    order:
      - file.name
      - type
