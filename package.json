{
	"name": "obsidian-base-graph",
	"version": "0.1.0",
	"description": "Graph view for Obsidian Bases",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"demo": "npm run build && mkdir -p demo-vault/.obsidian/plugins/base-graph && cp main.js manifest.json styles.css demo-vault/.obsidian/plugins/base-graph/"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/d3-force": "^3.0.10",
		"@types/d3-quadtree": "^3.0.6",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-zoom": "^3.0.8",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"d3-force": "^3.0.0",
		"d3-quadtree": "^3.0.1",
		"d3-selection": "^3.0.0",
		"d3-zoom": "^3.0.0"
	}
}
